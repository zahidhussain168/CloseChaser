  "info": {
    "title": "RuledOff API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bookkeeper": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "portal": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ExchangeMagicLinkDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The opaque token from the emailed magic link."
          }
        },
        "required": [
          "token"
        ]
      },
      "ClientResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "close_day": {
            "type": "number",
            "nullable": true,
            "description": "Day of the month the books are due to close."
          },
          "auto_chase": {
            "type": "boolean",
            "description": "Start next month's close from the template automatically."
          },
          "qbo_realm_id": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "notes",
          "close_day",
          "auto_chase",
          "qbo_realm_id",
          "created_at"
        ]
      },
      "CreateClientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "closeDay": {
            "type": "number",
            "minimum": 1,
            "maximum": 28
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "UpdateClientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "closeDay": {
            "type": "number",
            "minimum": 1,
            "maximum": 28
          }
        }
      },
      "DeletedResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ]
      },
      "AttachmentResponse": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "mime": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "name",
          "size",
          "mime",
          "uploaded_at"
        ]
      },
      "ItemResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "requested",
              "nudged",
              "answered",
              "accepted"
            ]
          },
          "ruledOff": {
            "type": "boolean",
            "description": "Derived: the item is accepted."
          },
          "overdue": {
            "type": "boolean",
            "description": "Derived: still open past the grace period."
          },
          "daysOpen": {
            "type": "number"
          },
          "answerText": {
            "type": "string",
            "nullable": true
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "answeredAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "acceptedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "state",
          "ruledOff",
          "overdue",
          "daysOpen",
          "answerText",
          "attachments",
          "createdAt",
          "answeredAt",
          "acceptedAt"
        ]
      },
      "CreateItemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "transaction",
              "document",
              "questionnaire"
            ]
          },
          "title": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title"
        ]
      },
      "SignedUrlResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "SignUploadDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number",
            "description": "Bytes. Rejected above the bucket limit."
          }
        },
        "required": [
          "filename",
          "mime",
          "size"
        ]
      },
      "SignedUploadResponse": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Server-derived object path. Never caller supplied."
          },
          "token": {
            "type": "string"
          },
          "signedUrl": {
            "type": "string"
          },
          "bucket": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "token",
          "signedUrl",
          "bucket"
        ]
      },
      "AnswerItemDto": {
        "type": "object",
        "properties": {
          "answerText": {
            "type": "string",
